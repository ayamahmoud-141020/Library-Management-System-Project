<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <style>
		body {
			display: flex;
			align-items: center;
			justify-content: center;
			min-height: 100vh; 
			width: 100%;
			padding: 0 10px; 
			position: relative; 
			background: url('@Url.Content("~/image/background.jpg")') center/cover no-repeat;
			
		}
		.wrapper {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 100%; /* اجعلي العرض 100% ليملأ الجسم بالكامل */
			height: 100vh; /* اجعلي الارتفاع يغطي الشاشة بالكامل */
		}

		.inner {
			display: flex;
			justify-content: space-between;
			width: 500px; /* تم التعديل ليناسب الصورة والفورم */
			background-color: rgba(0, 0, 0, 0.7); /* 0.7 هي نسبة الشفافية */
			box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
			padding: 20px;
			border-radius: 10px;
		}


		form {
			flex: 2;
			padding: 40px;
			/* جعل خلفية الفورم شفافة */
			/* background-color: rgba(255, 255, 255, 0.5); /* يمكنك تغيير قيمة الشفافية */ */
		}

		h2{
		font-size: 2rem;
		color: white; /* اجعل اللون أبيض */
		text-align: center;
		font-weight: bold;
			
		}

		.form-holder {
			position: relative;
			margin: 0 auto; /* يجعل الهامش الأيمن والأيسر تلقائياً لتمركز العنصر */
			width: 90%; /* يمكنك تغيير هذا إلى عرض محدد مثل 400px */
			max-width: 500px; /* الحد الأقصى لعرض الفورم */
			margin-bottom: 21px;
			display: flex; 
			justify-content: center; 
			align-items: center; 
			color:white;
		}


		.form-control {
			border: none;
			border-bottom: 1px solid white;
			display: block;
			width: 100%;
			height: 38px;
			background: none;
			padding: 3px 42px 0px;
			color: white;
			font-family: "Muli-SemiBold";
			font-size: 16px;
		}

		button {
			border: none;
			width: 40%; /* يمكنك تغيير هذا إلى أي عرض تريده */
			height: 49px;
			margin-top: 30px;
			cursor: pointer;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 0;
			background: white;
			color: black;
			/* text-transform: uppercase; */
			font-family: "Muli-SemiBold";
			font-size: 15px;
			letter-spacing: 2px;
			transition: all 0.5s;
			margin-left: auto; /* يضيف هوامش تلقائية على اليسار */
			margin-right: auto; /* يضيف هوامش تلقائية على اليمين */
			font-weight: bold;
		}

		.message {
			text-align: center; /* لجعل النص في منتصف الفقرة */
			color: white; /* لون النص */
		}
	</style>
</head>
<body>
    <div class="wrapper">
        <div class="inner">
             <div class="form-icon">
                <span><i class="icon icon-user"></i></span>
            </div> 
            <div class="form-holder">
                @RenderBody()
            </div>
        
        </div>
    </div>
</body>
</html>
